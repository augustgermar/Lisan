__pycache__/
*.pyc
*.egg-info/
# The live config holds local settings and secrets (telegram token) and is
# never tracked; config.example.json is the shipped template.
config.json
config.yaml
lisan.sqlite
embeddings.bin
transcript_embeddings.bin
.DS_Store

# User-local vault data. Keep personal memories, reports, transcripts, and
# primer files out of the public repo even when LISAN_VAULT points at the
# repo-local fallback path.
lisan-vault/
Draft5.md
lisan-vault/drafts/
lisan-vault/reports/
lisan-vault/logs/
lisan-vault/transcripts/
# Self-repair reports and confirmations contain proposed diffs, diagnostics,
# and task summaries that may include personal or otherwise sensitive data.
# Keep these explicit even though the vault root is ignored above.
lisan-vault/reports/self-repair-proposals/
lisan-vault/confirmations/
# A temporary patch file may be created inside a configured proposal worktree.
**/.self-repair.patch
lisan-vault/backup.md
lisan-vault/primer/current-brief.md
# Explicit belt-and-suspenders coverage for the vault-local high-stakes file.
lisan-vault/primer/high-stakes.yaml
# Same for the authority document and its version history: intent.md is
# personal even in a dev vault, and must survive any .gitignore refactor.
lisan-vault/primer/intent.md
lisan-vault/primer/intent-history/

# ── Sensitive-data firewall (2026-07-05, real data now flows) ──────────────
# No log file is ever publishable: logs carry chat blurbs, the instance's
# self-chosen name, and — with real data — the owner's life. Same for eval
# outputs, baselines, traces, and anything conversation-shaped.
*.log
*.jsonl
logs/
traces/
evals/baselines/
eval-reports/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm


# OAuth tokens and any credential material — never trackable
credentials/
*.token
token.json
# The agent's browser profile holds cookies and saved passwords
browser-profile/
browser-shots/

# Skill *contents* are the owner's; the folder itself ships. A downloader gets
# the skills machinery — the Agent Skills loader, progressive disclosure,
# `lisan skills validate|migrate` — plus an empty skills/ with a README showing
# where their own skills go, and none of anyone else's procedures.
#
# `skills/*`, not `skills/`: git does not descend into an ignored directory, so
# a negation inside one never matches and the README would vanish from the
# clone along with everything else. Verified, because it looks like it works.
skills/*
!skills/README.md
